# Địa chỉ công khai của site (dùng cho sitemap, thẻ chia sẻ, link trong thông báo)
SITE_URL=https://haiduong.vn

# Nơi lưu database SQLite và ảnh tải lên (đường dẫn tuyệt đối trên VPS)
DATA_DIR=/var/www/haiduong/data

# Đăng nhập trang quản trị. Tạo hash bằng: npm run admin:password -- "mat-khau"
ADMIN_EMAIL=hualac09@gmail.com
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự: openssl rand -base64 48
SESSION_SECRET=

# Tài khoản nhận chuyển khoản (hiện VietQR trên trang thanh toán)
BANK_BIN=970436
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# SePay: Cấu hình webhook -> URL https://<domain>/api/webhooks/sepay, Kiểu chứng thực "API Key"
SEPAY_API_KEY=

# Thông báo Telegram: tạo bot qua @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
